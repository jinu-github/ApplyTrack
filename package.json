{
  "name": "applytrack",
  "private": true,
  "version": "0.1.0",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm run vite\" \"npm run electron:dev\"",
    "vite": "vite",
    "electron": "electron .",
    "electron:dev": "wait-on tcp:127.0.0.1:5173 && electron .",
    "web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "dotenv": "^17.4.2",
    "framer-motion": "^13.2.0",
    "google-auth-library": "^11.0.2",
    "googleapis": "^178.0.0",
    "html-to-text": "^10.0.1",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "sanitize-html": "^2.17.7",
    "vite": "latest"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "electron": "^44.1.1",
    "electron-builder": "latest",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.applytrack.desktop",
    "productName": "ApplyTrack",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/applytrack.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
